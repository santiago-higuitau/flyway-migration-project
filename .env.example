# cp .env.example .env, y pega los connection strings de tu proyecto Neon.
# Nunca se hace commit de .env (ver .gitignore).

# Branch dev; se modifica en local.
NEON_DEV_DATABASE_URL=postgresql://usuario:password@ep-xxxx-xxxx-dev.us-east-2.aws.neon.tech/neondb?sslmode=require

# Branch main; solo la modifica el workflow de GitHub Actions.
NEON_MAIN_DATABASE_URL=postgresql://usuario:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Snowflake -- usados por code/elt_neon_to_library_dw.py
SNOWFLAKE_ACCOUNT=xxxxx-xxxxx
SNOWFLAKE_USER=tu_usuario
SNOWFLAKE_PASSWORD=tu_password
SNOWFLAKE_WAREHOUSE=WH_LIBRARY
SNOWFLAKE_DATABASE=LIBRARY_DW
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=LIBRARY_LOADER
