# cp .env.example .env, y pega los connection strings de tu proyecto Neon.
# Nunca se hace commit de .env (ver .gitignore).

# Branch dev; se modifica en local.
# Entre comillas: el connection string de Neon suele traer `&` (channel_binding=require),
# y sin comillas zsh/bash lo interpreta como operador de shell al hacer `source .env`.
NEON_DEV_DATABASE_URL="postgresql://usuario:password@ep-xxxx-xxxx-dev.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Branch main; solo la modifica el workflow de GitHub Actions.
NEON_MAIN_DATABASE_URL="postgresql://usuario:password@ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Snowflake -- usados por code/elt_neon_to_library_dw.py
SNOWFLAKE_ACCOUNT=xxxxx-xxxxx
SNOWFLAKE_USER=tu_usuario
SNOWFLAKE_PASSWORD=tu_password
SNOWFLAKE_WAREHOUSE=WH_LIBRARY
SNOWFLAKE_DATABASE=LIBRARY_DW
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=LIBRARY_LOADER

DBT_SCHEMA_BASE=tu_schema_analitico
# dbt-core 1.11 deprecó target-path dentro de dbt_project.yml; se define aquí.
DBT_TARGET_PATH=dbt/target
